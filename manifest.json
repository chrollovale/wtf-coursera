{
  "name": "WTF Coursera - Built by Aniket",
  "description": "Fuck these credit courses. A master override to bypass the artificial grind, automate completions, and reclaim your time.",
  "version": "1.0.0",
  "manifest_version": 3,
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": ["content.js"],
      "matches": ["https://www.coursera.org/*"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.coursera.org/*"
  ]
}